[TEMPLATE]
# Shared development configuration. Replace every credential before deployment.
APP_NAME=RAAM Spare-Parts Control
environment=development
DATABASE_URL=sqlite:///./raam_control.db
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
SECRET_KEY=replace-with-a-long-random-secret-before-deployment

# For Docker Compose, override DATABASE_URL with the service database URL:
# DATABASE_URL=postgresql+psycopg://raam:replace-me@db:5432/raam_control
# Frontend API URL (Vite reads this at build time):
VITE_API_BASE_URL=http://localhost:8000
POSTGRES_DB=raam_control
POSTGRES_USER=raam
POSTGRES_PASSWORD=replace-me-with-a-long-random-password

# Real local computer-vision provider. It decodes QR/barcodes, recognizes ArUco
# bin tags and runs real Tesseract OCR on the exact live-camera frame.
# It deliberately returns count/occupancy as null until calibrated models exist.
VISION_PROVIDER_URL=http://vision:8100/analyze
VISION_PROVIDER_API_KEY=local-vision-key-change-me
VISION_MAX_IMAGE_BYTES=10485760
VISION_PROVIDER_TIMEOUT_SECONDS=30
VISION_MAX_CONCURRENT_REQUESTS=3
VISION_ALLOW_HTTPS_EVIDENCE=false

# Live camera sampling contract sent to the UI. Frames are sampled, not a fake stream.
LIVE_CAMERA_MIN_INTERVAL_MS=1500
LIVE_CAMERA_DEFAULT_INTERVAL_MS=4000
LIVE_CAMERA_MAX_INTERVAL_MS=30000
LIVE_CAMERA_MAX_FRAME_SIDE=1280
